# Namello production backend
PORT=8787
NODE_ENV=development
# local = no Google credentials required; google = production verification
NAMELLO_AUTH_MODE=local
NAMELLO_DEV_USER_SUB=local-demo-user
GOOGLE_CLIENT_ID=
NAMELLO_SESSION_SECRET=namello-local-development-secret-change-before-production-please-64-chars
SESSION_TTL_SECONDS=43200
MAX_BODY_BYTES=2097152
# Comma-separated exact PWA origins. Never use * in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
DB_PATH=./data/namello.sqlite

# Strategic LLM Copilot (OpenAI-compatible chat completions endpoint)
NAMELLO_LLM_API_URL=
NAMELLO_LLM_API_KEY=
NAMELLO_LLM_MODEL=
