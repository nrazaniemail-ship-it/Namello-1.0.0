{
  "name": "namello-pwa",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "verify": "node scripts/verify-namello-version.mjs",
    "bump": "node scripts/bump-version.mjs",
    "build": "node scripts/build-web.mjs",
    "build:vite": "vite build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "android:add": "cap add android && node scripts/configure-android.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  }
}
